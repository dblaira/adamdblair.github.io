{
  "_comment": "Merge the 'hooks' block into ~/.claude/settings.json. Needs hooks/ and lib/ side by side, and bash + python3.",
  "env": {
    "ASK_BUDGET": "2"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-open-questions.sh"
          }
        ]
      }
    ]
  }
}
